  guidesOn: '<svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 5.5h12M5.5 3v12"/><path d="M9 3v12M3 9h12" opacity="0.45"/></svg>',
